<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(bot|admin|index|mobile|tv|tv-connect)\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <Files "tubetv-data.json">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Files>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # File privati, repository e dipendenze non devono mai essere serviti.
  RewriteRule ^(?:private|\.git|node_modules)(?:/|$) - [F,L,NC]

  # Residui locali e backup nella root: il database pubblico valido vive solo in data/.
  RewriteRule ^(?:\.env(?:\..*)?|index\.html\.bak|super_prompt\.txt|tubetv-data(?:[[:space:]]\([0-9]+\))?\.json|package(?:-lock)?\.json|README\.md|transform\.py|_.*\.js|.*-tests\.(?:php|js))$ - [F,L,NC]

  # Stato operativo non destinato al browser. Il client usa le API aggregate.
  RewriteRule ^data/(?:live-presence\.json|.*\.bak|\.bot.*|.*\.lock|.*\.tmp)$ - [F,L,NC]

  RewriteRule ^tv/?$ tv.html [L,NC]
  # La vecchia area IPTV privata e tutti i relativi endpoint sono dismessi.
  RewriteRule ^iptv(?:\.html|/)?$ / [R=302,L,NC]
  RewriteRule ^api/(?:_iptv-host-auth|iptv-[^/]+|tv-lite-iptv|tv-remote-catalog)\.php$ - [G,L,NC]
  RewriteRule ^host(?:/|$) - [G,L,NC]
  RewriteRule ^tv-connect/?$ tv-connect.html [L,NC]
</IfModule>
