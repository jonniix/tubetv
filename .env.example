# TubeTV – Server environment variables
# Copia questo file in .env e compila i valori reali.
# NON committare mai .env nel repository.

# xAI / Grok API key (richiesta da /api/grok-scheduler)
XAI_API_KEY=inserisci_la_tua_chiave_xai

# YouTube Data API v3 (sincronizzazione automatica dei canali dal cron PHP)
YOUTUBE_API_KEY=inserisci_la_tua_chiave_youtube

# Porta server (opzionale, default 3000)
# PORT=3000
