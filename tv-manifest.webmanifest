{
  "id": "/tv",
  "name": "TubeTV per Android TV",
  "short_name": "TubeTV",
  "description": "TubeTV ottimizzata per televisori e box Android TV.",
  "start_url": "/tv?source=pwa",
  "scope": "/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape",
  "background_color": "#05070b",
  "theme_color": "#05070b",
  "categories": ["entertainment", "video"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    { "src": "icons/icon-192.png?v=12", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png?v=12", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-192.png?v=12", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-512.png?v=12", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
